{
  "name": "LaTeX Log",
  "scopeName": "text.log.latex",
  "type": "tree-sitter",
  "parser": "tree-sitter-plain-text",
  "injectionNames": ["latex-log"],
  "firstLineRegex": ["^This is (?:e-p|e-up|Lua|pdf|Xe)?TeXk?, Version "],
  "contentRegex": "^This is (?:e-p|e-up|Lua|pdf|Xe)?TeXk?, Version ",
  "fileTypes": ["log"],
  "treeSitter": {
    "parserSource": "github:lumine-code/tree-sitter-plain-text#d09951812cbdbae67b5b19dc5864f7f29b5b0625",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "plain-text.wasm",
    "parseBoundariesQuery": "latex-log-parse-boundaries.scm",
    "parseBoundariesMaxStartDepth": 1,
    "parseBoundariesInjections": true,
    "highlightsQuery": "latex-log-highlights.scm",
    "injectionsQuery": "latex-log-injections.scm"
  }
}
